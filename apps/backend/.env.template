# 파일명은 .env.development.local 또는 .env.production.local
# 둘 다 있을 시 .env.production.local 우선 적용

NODE_ENV=production or development
PORT=server port, 거의 3000

DB_HOST=rdb host, 거의 localhost
DB_PORT=rdb port, 거의 5432
DB_USER=rdb user, 거의 devuser
DB_PASS=rdb password, 거의 devpass
DB_NAME=rdb name, 거의 doowelldevdb

# Vercel/Supabase에서는 아래 URL을 우선 사용합니다.
# 런타임: Supabase Transaction Pooler, 마이그레이션: Direct Connection
DATABASE_URL=postgresql://runtime-connection-url
DIRECT_DATABASE_URL=postgresql://migration-connection-url
DATABASE_POOL_MAX=1
DATABASE_SSL=true

SESSION_SECRET=session secret key
SESSION_MAX_AGE_MS=session cookie max age in ms, 예: 604800000 -> 7일

CLOVA_API_KEY=clova api, Optional (미설정 시 AI 기능만 503 응답)

VAPID_PUBLIC_KEY=pnpm dlx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=pnpm dlx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin-example@web24.app

SENTRY_DSN=sentry dsn
SENTRY_ENV=environment (local, staging, production)
SENTRY_RELEASE=release identifier (e.g. git sha)
SENTRY_TRACES_SAMPLE_RATE=trace sampling rate (e.g. 0.1)
SENTRY_PROFILES_SAMPLE_RATE=profile sampling rate (e.g. 0.01)

GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# development에서는 기본 활성화됩니다. Preview에서 필요할 때만 true로 설정하세요.
# Production에서는 설정하지 않으면 /api/docs와 /api/docs-json이 등록되지 않습니다.
SWAGGER_ENABLED=true

SLACK_WEBHOOK_URL=슬랙 채널 웹 훅 URL, Optional
CRON_SECRET=16자 이상의 Vercel Cron 인증용 secret
